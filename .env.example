# Local development only. Never commit a real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSLMODE=disable

# Set false only for localhost HTTP. Keep true on HTTPS production hosting.
COOKIE_SECURE=false

# Temporary one-time secret used to create the first web super-admin at /setup.
# Remove it immediately after the first account is created.
WEB_BOOTSTRAP_TOKEN=replace_with_a_long_random_secret

# Optional legacy Telegram integration. Not needed to run the web portal.
TELEGRAM_BOT_TOKEN=
SUPER_ADMIN_TELEGRAM_ID=

# Required only if the optional Telegram bot is later switched to webhook mode.
WEBHOOK_SECRET=

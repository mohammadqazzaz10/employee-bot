# Copy this file to .env and fill in real values locally.
# Never commit .env or paste these secrets into GitHub/chat.

TELEGRAM_BOT_TOKEN=replace_with_botfather_token
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# prefer works with Render's internal connection string; use require for external TLS connections.
DATABASE_SSLMODE=prefer

# Obtain this numeric ID by messaging /my_id to your bot, then set it here.
# On first startup without it, the bot starts but has no administrator.
SUPER_ADMIN_TELEGRAM_ID=replace_with_your_telegram_numeric_id

# Render supplies PORT and RENDER_EXTERNAL_URL automatically for web services.
# Set WEBHOOK_URL only if you intentionally use a custom public base URL.
